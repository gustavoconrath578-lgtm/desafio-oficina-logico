digraph Oficina {
  graph [fontname="DejaVu Sans", bgcolor="white", pad="0.4", nodesep="0.45", ranksep="1.0", splines=polyline, rankdir=LR, label="Modelo lógico • Oficina mecânica", labelloc=t, fontsize=22, fontcolor="#17324b"];
  node [shape=plain, fontname="DejaVu Sans"];
  edge [color="#607b96", fontcolor="#425b72", fontsize=10, penwidth=1.3, arrowsize=0.6];
  cliente [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#b9c9d7"><TR><TD COLSPAN="2" BGCOLOR="#19344f"><FONT COLOR="white" POINT-SIZE="14"><B>CLIENTE</B></FONT></TD></TR><TR><TD BGCOLOR="#eaf1f7" ALIGN="LEFT"><FONT COLOR="#466985" POINT-SIZE="10"><B>PK</B></FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT"><FONT COLOR="#233a4e" POINT-SIZE="11">id_cliente</FONT></TD></TR><TR><TD BGCOLOR="#eaf1f7" ALIGN="LEFT"><FONT COLOR="#466985" POINT-SIZE="10"><B>UQ</B></FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT"><FONT COLOR="#233a4e" POINT-SIZE="11">cpf</FONT></TD></TR><TR><TD BGCOLOR="#eaf1f7" ALIGN="LEFT"><FONT COLOR="#466985" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT"><FONT COLOR="#233a4e" POINT-SIZE="11">nome</FONT></TD></TR><TR><TD BGCOLOR="#eaf1f7" ALIGN="LEFT"><FONT COLOR="#466985" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT"><FONT COLOR="#233a4e" POINT-SIZE="11">telefone</FONT></TD></TR><TR><TD BGCOLOR="#eaf1f7" ALIGN="LEFT"><FONT COLOR="#466985" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT"><FONT COLOR="#233a4e" POINT-SIZE="11">email</FONT></TD></TR></TABLE>>];
  veiculo [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#b9c9d7"><TR><TD COLSPAN="2" BGCOLOR="#19344f"><FONT COLOR="white" POINT-SIZE="14"><B>VEICULO</B></FONT></TD></TR><TR><TD BGCOLOR="#eaf1f7" ALIGN="LEFT"><FONT COLOR="#466985" POINT-SIZE="10"><B>PK</B></FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT"><FONT COLOR="#233a4e" POINT-SIZE="11">id_veiculo</FONT></TD></TR><TR><TD BGCOLOR="#eaf1f7" ALIGN="LEFT"><FONT COLOR="#466985" POINT-SIZE="10"><B>FK</B></FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT"><FONT COLOR="#233a4e" POINT-SIZE="11">id_cliente</FONT></TD></TR><TR><TD BGCOLOR="#eaf1f7" ALIGN="LEFT"><FONT COLOR="#466985" POINT-SIZE="10"><B>UQ</B></FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT"><FONT COLOR="#233a4e" POINT-SIZE="11">placa</FONT></TD></TR><TR><TD BGCOLOR="#eaf1f7" ALIGN="LEFT"><FONT COLOR="#466985" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT"><FONT COLOR="#233a4e" POINT-SIZE="11">marca, modelo, ano</FONT></TD></TR></TABLE>>];
  mecanico [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#b9c9d7"><TR><TD COLSPAN="2" BGCOLOR="#19344f"><FONT COLOR="white" POINT-SIZE="14"><B>MECANICO</B></FONT></TD></TR><TR><TD BGCOLOR="#eaf1f7" ALIGN="LEFT"><FONT COLOR="#466985" POINT-SIZE="10"><B>PK</B></FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT"><FONT COLOR="#233a4e" POINT-SIZE="11">id_mecanico</FONT></TD></TR><TR><TD BGCOLOR="#eaf1f7" ALIGN="LEFT"><FONT COLOR="#466985" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT"><FONT COLOR="#233a4e" POINT-SIZE="11">nome</FONT></TD></TR><TR><TD BGCOLOR="#eaf1f7" ALIGN="LEFT"><FONT COLOR="#466985" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT"><FONT COLOR="#233a4e" POINT-SIZE="11">especialidade</FONT></TD></TR><TR><TD BGCOLOR="#eaf1f7" ALIGN="LEFT"><FONT COLOR="#466985" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT"><FONT COLOR="#233a4e" POINT-SIZE="11">telefone</FONT></TD></TR></TABLE>>];
  equipe [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#b9c9d7"><TR><TD COLSPAN="2" BGCOLOR="#19344f"><FONT COLOR="white" POINT-SIZE="14"><B>EQUIPE</B></FONT></TD></TR><TR><TD BGCOLOR="#eaf1f7" ALIGN="LEFT"><FONT COLOR="#466985" POINT-SIZE="10"><B>PK</B></FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT"><FONT COLOR="#233a4e" POINT-SIZE="11">id_equipe</FONT></TD></TR><TR><TD BGCOLOR="#eaf1f7" ALIGN="LEFT"><FONT COLOR="#466985" POINT-SIZE="10"><B>UQ</B></FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT"><FONT COLOR="#233a4e" POINT-SIZE="11">nome</FONT></TD></TR></TABLE>>];
  equipe_mecanico [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#b9c9d7"><TR><TD COLSPAN="2" BGCOLOR="#19344f"><FONT COLOR="white" POINT-SIZE="14"><B>EQUIPE_MECANICO</B></FONT></TD></TR><TR><TD BGCOLOR="#eaf1f7" ALIGN="LEFT"><FONT COLOR="#466985" POINT-SIZE="10"><B>PK FK</B></FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT"><FONT COLOR="#233a4e" POINT-SIZE="11">id_equipe</FONT></TD></TR><TR><TD BGCOLOR="#eaf1f7" ALIGN="LEFT"><FONT COLOR="#466985" POINT-SIZE="10"><B>PK FK</B></FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT"><FONT COLOR="#233a4e" POINT-SIZE="11">id_mecanico</FONT></TD></TR></TABLE>>];
  ordem_servico [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#b9c9d7"><TR><TD COLSPAN="2" BGCOLOR="#19344f"><FONT COLOR="white" POINT-SIZE="14"><B>ORDEM_SERVICO</B></FONT></TD></TR><TR><TD BGCOLOR="#eaf1f7" ALIGN="LEFT"><FONT COLOR="#466985" POINT-SIZE="10"><B>PK</B></FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT"><FONT COLOR="#233a4e" POINT-SIZE="11">id_os</FONT></TD></TR><TR><TD BGCOLOR="#eaf1f7" ALIGN="LEFT"><FONT COLOR="#466985" POINT-SIZE="10"><B>FK</B></FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT"><FONT COLOR="#233a4e" POINT-SIZE="11">id_veiculo</FONT></TD></TR><TR><TD BGCOLOR="#eaf1f7" ALIGN="LEFT"><FONT COLOR="#466985" POINT-SIZE="10"><B>FK</B></FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT"><FONT COLOR="#233a4e" POINT-SIZE="11">id_equipe</FONT></TD></TR><TR><TD BGCOLOR="#eaf1f7" ALIGN="LEFT"><FONT COLOR="#466985" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT"><FONT COLOR="#233a4e" POINT-SIZE="11">status</FONT></TD></TR><TR><TD BGCOLOR="#eaf1f7" ALIGN="LEFT"><FONT COLOR="#466985" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT"><FONT COLOR="#233a4e" POINT-SIZE="11">data_emissao</FONT></TD></TR><TR><TD BGCOLOR="#eaf1f7" ALIGN="LEFT"><FONT COLOR="#466985" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT"><FONT COLOR="#233a4e" POINT-SIZE="11">data_conclusao</FONT></TD></TR><TR><TD BGCOLOR="#eaf1f7" ALIGN="LEFT"><FONT COLOR="#466985" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT"><FONT COLOR="#233a4e" POINT-SIZE="11">observacao</FONT></TD></TR></TABLE>>];
  servico [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#b9c9d7"><TR><TD COLSPAN="2" BGCOLOR="#19344f"><FONT COLOR="white" POINT-SIZE="14"><B>SERVICO</B></FONT></TD></TR><TR><TD BGCOLOR="#eaf1f7" ALIGN="LEFT"><FONT COLOR="#466985" POINT-SIZE="10"><B>PK</B></FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT"><FONT COLOR="#233a4e" POINT-SIZE="11">id_servico</FONT></TD></TR><TR><TD BGCOLOR="#eaf1f7" ALIGN="LEFT"><FONT COLOR="#466985" POINT-SIZE="10"><B>UQ</B></FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT"><FONT COLOR="#233a4e" POINT-SIZE="11">descricao</FONT></TD></TR><TR><TD BGCOLOR="#eaf1f7" ALIGN="LEFT"><FONT COLOR="#466985" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT"><FONT COLOR="#233a4e" POINT-SIZE="11">valor_referencia</FONT></TD></TR></TABLE>>];
  peca [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#b9c9d7"><TR><TD COLSPAN="2" BGCOLOR="#19344f"><FONT COLOR="white" POINT-SIZE="14"><B>PECA</B></FONT></TD></TR><TR><TD BGCOLOR="#eaf1f7" ALIGN="LEFT"><FONT COLOR="#466985" POINT-SIZE="10"><B>PK</B></FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT"><FONT COLOR="#233a4e" POINT-SIZE="11">id_peca</FONT></TD></TR><TR><TD BGCOLOR="#eaf1f7" ALIGN="LEFT"><FONT COLOR="#466985" POINT-SIZE="10"><B>UQ</B></FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT"><FONT COLOR="#233a4e" POINT-SIZE="11">nome</FONT></TD></TR><TR><TD BGCOLOR="#eaf1f7" ALIGN="LEFT"><FONT COLOR="#466985" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT"><FONT COLOR="#233a4e" POINT-SIZE="11">preco_atual</FONT></TD></TR><TR><TD BGCOLOR="#eaf1f7" ALIGN="LEFT"><FONT COLOR="#466985" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT"><FONT COLOR="#233a4e" POINT-SIZE="11">quantidade_estoque</FONT></TD></TR></TABLE>>];
  item_servico [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#b9c9d7"><TR><TD COLSPAN="2" BGCOLOR="#19344f"><FONT COLOR="white" POINT-SIZE="14"><B>ITEM_SERVICO</B></FONT></TD></TR><TR><TD BGCOLOR="#eaf1f7" ALIGN="LEFT"><FONT COLOR="#466985" POINT-SIZE="10"><B>PK FK</B></FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT"><FONT COLOR="#233a4e" POINT-SIZE="11">id_os</FONT></TD></TR><TR><TD BGCOLOR="#eaf1f7" ALIGN="LEFT"><FONT COLOR="#466985" POINT-SIZE="10"><B>PK FK</B></FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT"><FONT COLOR="#233a4e" POINT-SIZE="11">id_servico</FONT></TD></TR><TR><TD BGCOLOR="#eaf1f7" ALIGN="LEFT"><FONT COLOR="#466985" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT"><FONT COLOR="#233a4e" POINT-SIZE="11">quantidade</FONT></TD></TR><TR><TD BGCOLOR="#eaf1f7" ALIGN="LEFT"><FONT COLOR="#466985" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT"><FONT COLOR="#233a4e" POINT-SIZE="11">valor_unitario</FONT></TD></TR></TABLE>>];
  item_peca [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#b9c9d7"><TR><TD COLSPAN="2" BGCOLOR="#19344f"><FONT COLOR="white" POINT-SIZE="14"><B>ITEM_PECA</B></FONT></TD></TR><TR><TD BGCOLOR="#eaf1f7" ALIGN="LEFT"><FONT COLOR="#466985" POINT-SIZE="10"><B>PK FK</B></FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT"><FONT COLOR="#233a4e" POINT-SIZE="11">id_os</FONT></TD></TR><TR><TD BGCOLOR="#eaf1f7" ALIGN="LEFT"><FONT COLOR="#466985" POINT-SIZE="10"><B>PK FK</B></FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT"><FONT COLOR="#233a4e" POINT-SIZE="11">id_peca</FONT></TD></TR><TR><TD BGCOLOR="#eaf1f7" ALIGN="LEFT"><FONT COLOR="#466985" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT"><FONT COLOR="#233a4e" POINT-SIZE="11">quantidade</FONT></TD></TR><TR><TD BGCOLOR="#eaf1f7" ALIGN="LEFT"><FONT COLOR="#466985" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT"><FONT COLOR="#233a4e" POINT-SIZE="11">valor_unitario</FONT></TD></TR></TABLE>>];
  cliente -> veiculo [label="1:N"];
  veiculo -> ordem_servico [label="1:N"];
  equipe -> ordem_servico [label="1:N"];
  equipe -> equipe_mecanico [label="1:N"];
  mecanico -> equipe_mecanico [label="1:N"];
  ordem_servico -> item_servico [label="1:N"];
  servico -> item_servico [label="1:N"];
  ordem_servico -> item_peca [label="1:N"];
  peca -> item_peca [label="1:N"];
  { rank=same; cliente; mecanico; servico; peca; }
  { rank=same; veiculo; equipe; }
  { rank=same; ordem_servico; equipe_mecanico; }
  { rank=same; item_servico; item_peca; }
}